#include <winver.h>
1 ICON "icon.ico"
1 24 "app.manifest"
VS_VERSION_INFO VERSIONINFO
FILEVERSION 1,1,0,0
PRODUCTVERSION 1,1,0,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "StockPilot"
      VALUE "FileDescription", "StockPilot Setup"
      VALUE "FileVersion", "1.1"
      VALUE "ProductName", "StockPilot"
      VALUE "ProductVersion", "1.1"
      VALUE "OriginalFilename", "StockPilot-Setup.exe"
      VALUE "LegalCopyright", "Fan-made mod for Screen Stocks"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
