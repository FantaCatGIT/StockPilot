#!/bin/bash
# StockPilot - macOS launcher
APP="$(cd "$(dirname "$0")/../.." && pwd)"
DATA="$HOME/Library/Application Support/StockPilot"
mkdir -p "$DATA"
OLD="$HOME/Library/Application Support/ScreenStocksPanel"
if [ -d "$OLD" ]; then pkill -f 'ScreenStocksPanel.ps1' 2>/dev/null; [ -e "$DATA/ScreenStocksRules.json" ] || cp -a "$OLD/." "$DATA/" 2>/dev/null; rm -rf "$OLD"; fi
OLD2="$HOME/Library/Application Support/FantaStocks"   # old name
if [ -d "$OLD2" ]; then pkill -f 'FantaStocks.ps1' 2>/dev/null; sleep 1; [ -e "$DATA/ScreenStocksRules.json" ] || cp -a "$OLD2/." "$DATA/" 2>/dev/null; rm -rf "$OLD2" "/Applications/FantaStocks.app" "$HOME/Applications/FantaStocks.app" 2>/dev/null; fi
dlg()  { osascript -e "display dialog \"$1\" with title \"StockPilot\" buttons {\"OK\"} default button 1" >/dev/null 2>&1; }
note() { osascript -e "display notification \"$1\" with title \"StockPilot\"" >/dev/null 2>&1; }
export DOTNET_SYSTEM_GLOBALIZATION_INVARIANT=1 POWERSHELL_TELEMETRY_OPTOUT=1 POWERSHELL_UPDATECHECK=Off
PWSH=""
for p in "$DATA/pwsh/pwsh" /opt/homebrew/bin/pwsh /usr/local/bin/pwsh "$(command -v pwsh 2>/dev/null)"; do
  if [ -n "$p" ] && [ -x "$p" ]; then PWSH="$p"; break; fi
done
if [ -z "$PWSH" ]; then
  case "$(uname -m)" in arm64) ARCH=osx-arm64;; *) ARCH=osx-x64;; esac
  note "First start: downloading PowerShell (about 70 MB). This only happens once."
  TMP="$(mktemp -d)"
  if curl -fsSL "https://github.com/PowerShell/PowerShell/releases/download/v7.4.6/powershell-7.4.6-$ARCH.tar.gz" -o "$TMP/p.tgz"; then
    mkdir -p "$DATA/pwsh" && tar -xzf "$TMP/p.tgz" -C "$DATA/pwsh" && chmod +x "$DATA/pwsh/pwsh"
    xattr -dr com.apple.quarantine "$DATA/pwsh" 2>/dev/null
  fi
  rm -rf "$TMP"
  if [ -x "$DATA/pwsh/pwsh" ]; then PWSH="$DATA/pwsh/pwsh"; else dlg "Could not download PowerShell. Check your internet connection and try again."; exit 1; fi
fi
cp "$APP/Contents/Resources/StockPilot.ps1" "$DATA/StockPilot.ps1"
export SSBOT_DATA="$DATA"
exec "$PWSH" -NoProfile -File "$DATA/StockPilot.ps1" >/dev/null 2>&1
