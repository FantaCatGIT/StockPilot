// StockPilot.exe icon + version info (compiled with: llvm-rc /FO resources.res exe.rc)
LANGUAGE 0x09, 0x01
1 ICON "icon.ico"
1 VERSIONINFO
 FILEVERSION 2,0,0,0
 PRODUCTVERSION 2,0,0,0
 FILEFLAGSMASK 0x3f
 FILEFLAGS 0x0
 FILEOS 0x40004
 FILETYPE 0x1
 FILESUBTYPE 0x0
BEGIN
