    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "StockPilot"
      VALUE "FileDescription", "StockPilot"
      VALUE "FileVersion", "2.0.0"
      VALUE "InternalName", "StockPilot"
      VALUE "LegalCopyright", "MIT License - fan-made mod for Screen Stocks"
      VALUE "OriginalFilename", "StockPilot.exe"
      VALUE "ProductName", "StockPilot"
      VALUE "ProductVersion", "2.0.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
